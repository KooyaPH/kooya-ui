--- a/es/Dom/focus.js
+++ b/es/Dom/focus.js
@@ -54,6 +54,9 @@ export function triggerFocus(element, option) {
     cursor
   } = option || {};
   if (cursor && (element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement)) {
+    // Some valid input types (email, number, date, etc.) cannot select text.
+    // Keep the requested focus without calling a native unsupported API.
+    if (element.selectionStart === null || element.selectionEnd === null) return;
     const len = element.value.length;
     switch (cursor) {
       case 'start':
@@ -128,14 +131,25 @@ function onWindowKeyDown(e) {
       activeElement
     } = document;
     const lastElement = getLastElement();
+    if (!lastElement || (!lastElement.contains(activeElement) && isIgnoredElement(activeElement))) return;
     const focusableList = getFocusNodeList(lastElement);
+    if (!focusableList.length) {
+      e.preventDefault();
+      lastFocusElement = lastElement;
+      lastElement.focus({ preventScroll: true });
+      return;
+    }
     const last = focusableList[focusableList.length - 1];
     if (e.shiftKey && activeElement === focusableList[0]) {
       // Tab backward on first focusable element
       lastFocusElement = last;
+      e.preventDefault();
+      last?.focus({ preventScroll: true });
     } else if (!e.shiftKey && activeElement === last) {
       // Tab forward on last focusable element
       lastFocusElement = focusableList[0];
+      e.preventDefault();
+      focusableList[0]?.focus({ preventScroll: true });
     }
   }
 }
