{
  "name": "@kooyaph/ui",
  "version": "0.3.0",
  "private": false,
  "license": "MIT",
  "description": "An atomic React component and template library with modular themes, built on Ant Design.",
  "keywords": [
    "react",
    "design-system",
    "atomic-design",
    "ant-design",
    "bento"
  ],
  "homepage": "https://github.com/KooyaPH/kooya-ui#readme",
  "bugs": {
    "url": "https://github.com/KooyaPH/kooya-ui/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./antd": {
      "types": "./dist/antd.d.ts",
      "import": "./dist/antd.js"
    },
    "./styles.css": "./dist/styles.css",
    "./foundations": {
      "types": "./dist/foundations/index.d.ts",
      "import": "./dist/foundations.js"
    },
    "./themes": {
      "types": "./dist/foundations/themes.d.ts",
      "import": "./dist/themes.js"
    },
    "./themes/mosaic": {
      "types": "./dist/foundations/themes/mosaic.d.ts",
      "import": "./dist/themes/mosaic.js"
    },
    "./themes/signature": {
      "types": "./dist/foundations/themes/signature.d.ts",
      "import": "./dist/themes/signature.js"
    },
    "./themes/canvas": {
      "types": "./dist/foundations/themes/canvas.d.ts",
      "import": "./dist/themes/canvas.js"
    },
    "./themes/client": {
      "types": "./dist/foundations/themes/client.d.ts",
      "import": "./dist/themes/client.js"
    },
    "./atoms": {
      "types": "./dist/atoms/index.d.ts",
      "import": "./dist/atoms.js"
    },
    "./molecules": {
      "types": "./dist/molecules/index.d.ts",
      "import": "./dist/molecules.js"
    },
    "./organisms": {
      "types": "./dist/organisms/index.d.ts",
      "import": "./dist/organisms.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "import": "./dist/templates.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "antd": "6.6.5"
  },
  "dependencies": {},
  "devDependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "antd": "6.6.5"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KooyaPH/kooya-ui.git",
    "directory": "packages/ui"
  }
}
